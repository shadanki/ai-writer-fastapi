NEXT_PUBLIC_API_BASE=http://localhost:8000

// 契約（既存APIに合わせる）
type CreateSessionReq = { topic: string; draft?: string | null; language?: 'ja'|'en' };
type CreateSessionRes = { sessionId: string };
type Title = { id: string; title: string; score?: number };
type TitlesRes = { candidates: Title[] } | Title[];
type SelectTitleReq = { sessionId: string; candidateId: string };
type OutlineRes = { outline: any } | any;
type ArticleRes = { markdown: string; sections?: string[] };
